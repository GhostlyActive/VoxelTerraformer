<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VoxelEngine</RootNamespace>
    <AssemblyName>VoxelEngine</AssemblyName>

    <!-- `dotnet pack Engine/Engine.csproj` gives a game in another repository the engine as a package -->
    <PackageId>VoxelEngine</PackageId>
    <Version>0.2.0</Version>
    <Description>A voxel engine on raylib: streamed terrain with three voxel modes, level of detail, sub-voxel sculpting and free-standing voxel bodies</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

</Project>
