<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Terraformer</RootNamespace>
  </PropertyGroup>

  <!-- Die Engine ist ein eigenes Projekt im Unterordner und darf hier nicht mitkompiliert werden -->
  <ItemGroup>
    <Compile Remove="Engine/**" />
    <None Remove="Engine/**" />
    <EmbeddedResource Remove="Engine/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Engine/Engine.csproj" />
  </ItemGroup>

  <!-- Assets landen unter Games/<Id>/Assets im Ausgabeordner — genau dort sucht GameContext.AssetPath -->
  <ItemGroup>
    <Content Include="Games/**/Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
