<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Terraformer</RootNamespace>
  </PropertyGroup>

  <!-- Engine and Tests are projects of their own in subfolders and must not be compiled in here -->
  <ItemGroup>
    <Compile Remove="Engine/**;Tests/**" />
    <None Remove="Engine/**;Tests/**" />
    <EmbeddedResource Remove="Engine/**;Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Engine/Engine.csproj" />
  </ItemGroup>

  <!-- Assets end up under Games/<Id>/Assets in the output folder, which is where GameContext.AssetPath looks -->
  <ItemGroup>
    <Content Include="Games/**/Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
