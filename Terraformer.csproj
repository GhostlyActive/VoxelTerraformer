<Project Sdk="Microsoft.NET.Sdk">

  <!-- The launcher: the window, the engine and every game under Games/. It has no game code of
       its own; the games are separate projects it references, and Program.cs discovers them
       through the attributes the build stamps below. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Terraformer</RootNamespace>

    <!-- Only Program.cs belongs to the launcher; Engine/, Games/ and Tests/ are projects of their own -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="Engine/Engine.csproj" />
  </ItemGroup>

  <!-- One [assembly: GameAssembly("Games.X")] per game project, so GameRegistry.AddFromLauncher
       can load them by name (also from a single-file publish, where a directory scan finds nothing) -->
  <ItemGroup>
    <GameProject Include="Games/*/*.csproj">
      <_Parameter1>Games.%(Filename)</_Parameter1>
    </GameProject>
    <ProjectReference Include="@(GameProject)" />
    <AssemblyAttribute Include="@(GameProject->'VoxelEngine.Core.GameAssemblyAttribute')" />
  </ItemGroup>

</Project>
